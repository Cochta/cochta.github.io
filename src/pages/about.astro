---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Constantin Verine" description="About Constantin Verine">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about me and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/MoiBasel.jpg"
					alt="Constantin Verine (me) at a convention presenting his project"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>I’m a <b>Software Engineer specializing in modern C++ and Unreal Engine</b>, 
						currently working at <b>Axiosys Studios</b>. 
						My main areas of interest include <b>systems programming</b>, 
						<b>software architecture</b>, <b>performance optimization</b>, and <b>real-time applications</b>.</p>
					</br>
					<p>I have designed and developed <b>custom 2D and 3D physics engines</b>,
						 extending this work into a <b>real-time SPH fluid simulation</b> accelerated with GPU compute shaders.
						  I also have professional and personnal experience developing <b>gameplay systems</b>, <b>engine features</b>,
						 and <b>development tools</b> using Unreal Engine, C++, and Python.</p>
					</br>
					<p>Alongside my professional work, I’m developing a <b>commercial simulation & management project</b> in Unreal Engine 5,
						 taking responsibility for its global architecture, gameplay systems, tools, and overall technical direction.</p>
					</br>
					<p>I speak <b>English</b>, <b>French</b>, <b>Russian</b>, <b>German</b>, and I enjoy tackling <b>complex technical problems</b>,
						 exploring new technologies, and building software from concept to implementation.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">CV</h2>
				
				<div class="content">
					<p>
					<iframe src="/Constantin_Verine_CV.pdf#navpanes=0&toolbar=1&statusbar=1&view=FitV" width="100%" height="1490px"/>
					</p>
								
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
